+async def get_arl_by_email_and_password(email: str, password: str, http_session: ClientSession) -> str:
+    '''Automatically returns ARL token by using the deezer API'''
+    cookie_manager = CookieManager()
+    # remove any existing cookies from http_session
+    http_session.cookie_jar.clear()
+
+    # get initial cookies (sid) from empty getUser call
+    response = await http_session.get('https://www.deezer.com/ajax/gw-light.php?method=deezer.getUserData&input=3&api_version=1.0&api_token=null')
+    cookie_manager.update_cookie(response)
+    http_session.cookie_jar.clear()
+
+    # Try to get AccessToken by login with email & password, which sets authentication cookies
+    token = await _get_accesstoken(email, password, cookie_manager, http_session)
+    if (token == None):
+        return ''
+
+    # get arl
+    request_headers = DEFAULT_HEADERS | cookie_manager.cookie_header
+    response = await http_session.get('https://www.deezer.com/ajax/gw-light.php?method=user.getArl&input=3&api_version=1.0&api_token=null', headers=request_headers)
+
+    data = await response.json()
+    return data['results']
+
+async def _get_accesstoken(email: str, password: str, cookie_manager: CookieManager, http_session: ClientSession):
+    # music-assistant
+    # DEEZER_APP_ID = '600344'
+    # DEEZER_APP_S = '1e79e9ecb000010147b7e31c21794b74'
+    # Spleeter, Deezloader creds (maybe)
+    # DEEZER_APP_ID = '243762'
+    # DEEZER_APP_S = 'a5cf06353c1d7083e2fca5a6885a1a74'
+    # Deezer API (same as streamrip & Orpheus)
+    DEEZER_APP_ID = '447462'
+    DEEZER_APP_S = 'a83bf7f38ad2f137e444727cfc3775cf'
+    # LastFM API original freezer
+    # LASTFM_API_ID = 'b6ab5ae967bcd8b10b23f68f42493829'
+    # LASTFM_API_S = '861b0dff9a8a574bec747f9dab8b82bf'
+
+    request_headers = DEFAULT_HEADERS | cookie_manager.cookie_header
+    hashed_pass = md5(password.encode('utf-8')).hexdigest()
+    hashed_params = md5(f'{DEEZER_APP_ID}{email}{hashed_pass}{DEEZER_APP_S}'.encode('utf-8')).hexdigest()
+
+    params = {'app_id': DEEZER_APP_ID, 'login': email, 'password': hashed_pass, 'hash': hashed_params}
+    url = f'https://connect.deezer.com/oauth/user_auth.php?{urllib.parse.urlencode(params)}'
+
+    response = await http_session.get(url, headers=request_headers)
+    cookie_manager.update_cookie(response)
+    json = await response.json()
+    if 'access_token' in json:
+        return json['access_token']
+    elif 'error' in json and any(json['error']):
+        raise ValueError(f'got an error of type \'{json["error"]["type"]}\', message: \'{json["error"]["message"]}\'')
+    return None
