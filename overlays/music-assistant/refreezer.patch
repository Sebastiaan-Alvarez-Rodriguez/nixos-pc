+    async def remove_playlist(self, id: str, owned_by_us: Optional[bool] = None):
+        '''
+        Delete a playlist (if user owns it) or remove it from favorites (if user does not own it).
+        Leave `owned_by_us` empty to let the API figure it out, at the cost of an extra API call.
+        '''
+        if owned_by_us == None:
+            playlist_raw = await self.playlist(id, nb=0)
+            owned_by_us = playlist_raw['results']['DATA']['PARENT_USER_ID'].strip() == self.user_id if playlist_raw['results']['DATA']['PARENT_USER_ID'] != None else False # no parent id --> not made by us
+
+        if owned_by_us:
+            await self.call_gw_api('playlist.delete', params={'playlist_id': id}) # full deletion
+        else:
+            await self.call_gw_api('playlist.deleteFavorite', params={'playlist_id': id}) # we don't own it, remove from library/favorites
