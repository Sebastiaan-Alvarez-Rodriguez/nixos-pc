+async def get_config_entries(
+    mass: MusicAssistant,
+    instance_id: str | None = None,
+    action: str | None = None,
+    values: dict[str, ConfigValueType] | None = None,
+) -> tuple[ConfigEntry, ...]:
+    """
+    Return Config entries to setup this provider.
+
+    instance_id: id of an existing provider instance (None if new instance setup).
+    action: [optional] action key called from config entries UI.
+    values: the (intermediate) raw values for config entries sent with the action.
+    """
+    if action == CONF_ACTION_AUTH:
+        values[CONF_REFREEZER_ARL] = await get_arl_by_email_and_password(values[CONF_REFREEZER_MAIL], values[CONF_REFREEZER_PASS], mass.http_session)
+
+    return (
+        ConfigEntry(
+            key=CONF_REFREEZER_MAIL,
+            type=ConfigEntryType.STRING,
+            label="email",
+            required=True,
+            description="Deezer email",
+            value=values.get(CONF_REFREEZER_MAIL) if values else None,
+        ),
+        ConfigEntry(
+            key=CONF_REFREEZER_PASS,
+            type=ConfigEntryType.SECURE_STRING,
+            label="password",
+            required=True,
+            description="Deezer password",
+            value=values.get(CONF_REFREEZER_PASS) if values else None,
+        ),
+        ConfigEntry(
+            key=CONF_REFREEZER_ARL,
+            type=ConfigEntryType.SECURE_STRING,
+            label="Get ARL token",
+            required=True,
+            action=CONF_ACTION_AUTH,
+            description="Deezer ARL token",
+            value=values.get(CONF_REFREEZER_ARL) if values else None,
+        ),
+    )
