+    async def search(self, query: str, start: int = 0, nb: int = 128) -> tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]]]:
+        '''
+        search deezer on the given query. Searches through all categories (e.g. artists, tracknames etc) at once.
+        Returns 4 lists with json data: tracks, albums, artists, playlists (in this order).
+        '''
+        data = await self.call_gw_api('deezer.pageSearch', params={'nb': nb, 'query': query, 'start': start})
+        if not 'results' in data:
+            return [], [], [], []
+        tracks = data['results'].get('TRACK', {}).get('data', [])
+        albums = data['results'].get('ALBUM', {}).get('data', [])
+        artists= data['results'].get('ARTIST', {}).get('data', [])
+        playlists = data['results'].get('PLAYLIST', {}).get('data', [])
+        return tracks, albums, artists, playlists
+
