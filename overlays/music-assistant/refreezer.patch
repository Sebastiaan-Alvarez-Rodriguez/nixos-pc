+class CookieManager:
+    '''handles obtaining session cookies from deezer'''
+    def __init__(self):
+        self.reset()
+
+    def reset(self):
+        self.cookie_header = {};
+        self.cookies = {};
+
+    def update_cookie(self, r: ClientResponse):
+        '''updates cookie info'''
+        if not any(r.headers['set-cookie']):
+            return
+        setcookies = r.headers.getall('set-cookie')
+        for setc in setcookies:
+            cookies = setc.split(';')
+            for c in cookies:
+                self._set_cookie(c)
+        self.cookie_header['cookie'] = self._generate_cookie_header();
+
+    def _set_cookie(self, cookie: str):
+        if (not cookie) or (not '=' in cookie):
+            return
+        key, value = [s.strip() for s in cookie.split('=', 1)]
+        if key.lower() in ['path', 'expires', 'domain', 'samesite']:
+            return # not interesting
+        # if we get here, this is an interesting cookie - keep it
+        self.cookies[key] = value
+
+    def _generate_cookie_header(self):
+        return ';'.join((f'{k}={v}'for k, v in self.cookies.items()))
+
