+    def _md5(self, data, data_type="ascii"):
+        md5sum = md5()
+        md5sum.update(data.encode(data_type))
+        return md5sum.hexdigest()
+    def get_blowfish_key(self, track_id):
+        """Get blowfish key to decrypt a chunk of a track."""
+        # secret = 'jo6aey6haid2Teih' # refreezer official key
+        secret = 'g4el58wc0zvf9na1' # deezer mass-implementation key (found in app_var(5))
+        self.logger.info(f'got secret: {secret}')
+        id_md5 = self._md5(track_id)
+        return "".join(chr(ord(id_md5[i]) ^ ord(id_md5[i + 16]) ^ ord(secret[i])) for i in range(16))
+    def decrypt_chunk(self, chunk, blowfish_key):
+        """Decrypt a given chunk using the blow fish key."""
+        cipher = Blowfish.new(
+            blowfish_key.encode("ascii"),
+            Blowfish.MODE_CBC,
+            b"\x00\x01\x02\x03\x04\x05\x06\x07",
+        )
+        return cipher.decrypt(chunk)
+
+    # seb NOTE: a very basic encryption is used for the stream, as the music of a sample url is well-audible despite noise.
+    # Found these options to decrypt:
+    # 1. deezer mass provider
+    #   + we use the same url to call, so should process encryption data similarly
+    #   - uses stupid app_vars, so have to take it out again
+    # 2. refreezer DeezerDecryptor.
+    #   + seems simple enough
+    #   + might match encryption pattern (weak)
+    #   - not used by refreezer except when using the 'streaming server' and other offline tracks functionalities
+    # 3. refreezer 'generateTrackUrl'
+    #   + related to 2
+    #   - only used for offline track functionality?
+    #   - only call in 'getTrackUrl', with comment: "Deprecated legacy url generation. Seems unavailable now."
+    async def get_audio_stream(self, streamdetails: StreamDetails, seek_position: int=0) -> AsyncGenerator[bytes, None]:
+        """ Return the (custom) audio stream for the provider item. """
+        blowfish_key = self.get_blowfish_key(streamdetails.data['track_id'])
+        chunk_index = 0
+        timeout = ClientTimeout(total=0, connect=30, sock_read=600)
+        # headers = self.api.get_headers()
+        headers = {}
+        # if seek_position and streamdetails.size:
+        #     chunk_count = ceil(streamdetails.size / 2048)
+        #     chunk_index = int(chunk_count / streamdetails.duration) * seek_position
+        #     skip_bytes = chunk_index * 2048
+        #     headers["Range"] = f"bytes={skip_bytes}-"
+
+        # NOTE: Seek with using the Range header is not working properly
+        # causing malformed audio so this is a temporary patch
+        # by just skipping chunks
+        if seek_position and streamdetails.size:
+            chunk_count = ceil(streamdetails.size / 2048)
+            skip_chunks = int(chunk_count / streamdetails.duration) * seek_position
+        else:
+            skip_chunks = 0
+
+        buffer = bytearray()
+        streamdetails.data['start_ts'] = utc_timestamp()
+        streamdetails.data['stream_id'] = uuid.uuid1()
+        # self.mass.create_task(self.gw_client.log_listen(next_track=streamdetails.item_id))
+        async with self.api.session.get(streamdetails.data['url'], headers=headers, timeout=timeout) as resp:
+            self.logger.info(f'Got stream status {resp.status}, reason="{resp.reason}"')
+            self.logger.info(f'Resulting stream is of type "{resp.content_type}". Found headers: "{resp.headers}"')
+            async for chunk in resp.content.iter_chunked(2048):
+                buffer += chunk
+                if len(buffer) >= 2048:
+                    if chunk_index >= skip_chunks or chunk_index == 0:
+                        if chunk_index % 3 > 0:
+                            yield bytes(buffer[:2048])
+                        else:
+                            yield self.decrypt_chunk(bytes(buffer[:2048]), blowfish_key)
+
+                    chunk_index += 1
+                    del buffer[:2048]
+        yield bytes(buffer)
