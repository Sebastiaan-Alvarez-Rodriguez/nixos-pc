+                ),
+            },
+            disc_number=int(data['DISK_NUMBER'] if 'DISK_NUMBER' in data and data['DISK_NUMBER'] != None else 0),
+            track_number=int(data['TRACK_NUMBER'] if 'TRACK_NUMBER' in data and data['TRACK_NUMBER'] != None else 0),
+            artists=self._parse_artists(data['ARTISTS'] if 'ARTISTS' in data else [data]),
+            album=self._parse_album(data)
+        )
+        track.metadata.explicit = 'EXPLICIT_LYRICS' in data and data['EXPLICIT_LYRICS'] == 1
+        if 'ALB_PICTURE' in data:
+            details = DeezerAPI.ImageDetails.from_private_string(data['ALB_PICTURE']) # seb TODO: used to be: 'from_private_json' (but that does not work from search-origin)
+            track.metadata.images = [
+                MediaItemImage(
+                    type=ImageType.THUMB,
+                    path=details.thumb_url, # seb TODO: can also provide full url? Maybe both?
+                    provider=self.lookup_key,
+                    remotely_accessible=True
+                )
+            ]
+        return track
+
+    def _parse_playlists(self, data: Dict) -> list[Playlist]:
+        return [self._parse_playlist(elem) for elem in data]
+
+    def _parse_playlist(self, data: Dict[str, Any]) -> Playlist:
+        is_editable = data['PARENT_USER_ID'] == self.api.user_id if data['PARENT_USER_ID'] != None else False # if id == None --> not made by us
+        playlist = Playlist(
+            item_id = data['PLAYLIST_ID'],
+            provider=self.instance_id if is_editable else self.lookup_key,
+            name=data['TITLE'],
+            owner=data.get('PARENT_USERNAME', ''),
+            provider_mappings={
+                ProviderMapping(
+                    item_id=data['PLAYLIST_ID'],
+                    provider_domain=self.domain,
+                    provider_instance=self.instance_id,
+                    available=True,
+                )
+            },
+            is_editable=is_editable,
+        )
+        details = DeezerAPI.ImageDetails.from_private_string(data['PLAYLIST_PICTURE']) # seb TODO: used to be: 'from_private_json' (but that does not work from search-origin)
+        playlist.metadata.images = [
+            MediaItemImage(
+                type=ImageType.THUMB,
+                path=details.thumb_url, # seb TODO: can also provide full url? Maybe both?
+                provider=self.lookup_key,
+                remotely_accessible=True
+            )
+        ]
+        # playlist.cache_checksum = str(playlist_obj["snapshot_id"])
+        # seb NOTE: no checksums provided by Deezer
+        return playlist
+
+    def _parse_track_details(self, data: Dict) -> StreamDetails:
+        content_type = ContentType.UNKNOWN # let FFMPEG guess the contenttype
+        bitrate = None
+        quality = self.config.get_value(CONF_REFREEZER_QUALITY)
+        size = None
+        if f'FILESIZE_{quality}' in data and data[f'FILESIZE_{quality}'] != '0':
+            size = data[f'FILESIZE_{quality}']
+            c = quality.split('_')
+            content_type = ContentType.try_parse(c[0])
+            bitrate = int(c[1] if len(c) >= 2 else None)
+        else:
+            for cat in ['AAC_64', 'MP3_64', 'MP3_128', 'MP3_256', 'MP3_320', 'FLAC']:
+                if data[f'FILESIZE_{cat}'] != "0":
+                    size = data[f'FILESIZE_{cat}']
+                    c = cat.split('_')
+                    content_type = ContentType.try_parse(c[0])
+                    bitrate = int(c[1] if len(c) >= 2 else None)
+
+        self.logger.debug(f'Using format details for item id {data["SNG_ID"]}: {content_type} @ {bitrate} kbits')
+        return StreamDetails(
+            item_id=data['SNG_ID'],
+            provider=self.lookup_key,
+            audio_format=AudioFormat(content_type=content_type, bit_rate=bitrate), # seb TODO: have to set bit_depth (default 16) and sample_rate (default 44100) too?
+            stream_type=StreamType.CUSTOM, # seb NOTE: used to be HTTP
+            duration=int(data['DURATION']),
+            data={'track_id': data['SNG_ID']}, # seb NOTE: cann pass in data here, passed on to the get_audio_stream funciton.
+            size=int(size) if size else None,
+            can_seek=True,
+            allow_seek=True,
+        )
