+class DeezerAPI:
+    class Settings:
+        defaults = {
+            'deezer_language': 'en',
+            'deezer_country': 'US'
+        }
+        def __init__(**kwargs):
+            '''populate settings using passed kwargs, default value otherwise'''
+            pick = lambda name: kwargs[name] if name in kwargs else defaults[name]
+            self.deezer_language: str = pick('deezer_language')
+            self.deezer_country: str = pick('deezer_country')
+
+    class ImageDetails:
+        def __init__(self, full_url: str, thumb_url: str, type: str, image_hash: str):
+            self.full_url = full_url
+            self.thumb_url = thumb_url
+            self.type = type
+            self.image_hash = image_hash
+
+        def from_private_string(image_hash: str, type: str = 'cover') -> ImageDetails:
+            return ImageDetails(full_url=custom_url(image_hash, type, 1000, 1000, 80), thumb_url=custom_url(image_hash, type, 140, 140, 80), type=type, image_hash=image_hash)
+
+        def from_private_json(data: Dict) -> ImageDetails:
+            return ImageDetails.from_private_string(data['MD5'] if 'MD5' in data and data['MD5'] != None else data['md5'], data['TYPE'] if 'TYPE' in data and data['TYPE'] != None else data['type'])
+
+        def custom_url(image_hash: str, type: str, height: int, width: int, quality: int) -> str:
+            return f'https://e-cdns-images.dzcdn.net/images/{type}/{image_hash}/{height}x{width}-000000-{quality}-0-0.jpg'
+            
+        def custom_url(self, height: int, width: int, quality: int) -> str:
+            return ImageDetail.custom_url(self.image_hash, self.type, height, width, quality)
+
+
+    user_agent = 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36'
+
+    def __init__(self, arl: Optional[str] = None, settings: Optional[Settings] = None):
+        self.arl = arl
+        self.token: Optional[str] = None
+        self.license_token: Optional[str] = None
+        self.user_id: Optional[str] = None
+        self.user_name: Optional[str] = None
+        self.favorites_playlist_id: Optional[str] = None
+        self.sid: Optional[str] = None
+        self._authorizing: Optional[asyncio.Future] = None
+        self.settings: Settings = settings or Settings()
+
+    def get_headers(self) -> Dict[str, str]:
+        lang = f'{self.settings.deezer_language}-{self.settings.deezer_country}'
+        cookie = f'arl={self.arl}' if self.sid == None else f'arl={self.arl}; sid={self.sid}'
+        return {
+            'User-Agent': self.user_agent,
+            'Content-Language': lang,
+            'Content-Type': 'text/plain;charset=UTF-8',
+            'Accept': ''*/*'',
+            'Accept-Charset': 'utf-8,ISO-8859-1;q=0.7,*;q=0.3',
+            'Accept-Language': f'{lang},{self.settings.deezer_language};q=0.9,en-US;q=0.8,en;q=0.7',
+            'Connection': 'keep-alive',
+            'Cookie': cookie,
+        }
+
+    async def call_gw_api(self, method: str, params: Optional[Dict] = None, gateway_input: Optional[str] = None) -> Dict[str, Any]:
+        url = 'https://www.deezer.com/ajax/gw-light.php'
+        query = {
+            'api_version': '1.0',
+            'api_token': self.token,
+            'input': '3',
+            'method': method,
+            'cid': str(random.randint(0, 1_000_000_000)),
+        }
+        if gateway_input:
+            query['gateway_input'] = gateway_input
+
+        headers = self.get_headers()
+        async with aiohttp.ClientSession() as session: # seb TODO: Could reuse hass-wide session?
+            async with session.post(url, headers=headers, params=query, data=json.dumps(params or {})) as resp:
+                body = await resp.json()
+
+                # Grab SID cookie
+                if method == 'deezer.getUserData':
+                    set_cookie = resp.headers.get('Set-Cookie', '')
+                    for cookie in set_cookie.split('';''):
+                        if cookie.strip().startswith('sid=''):
+                            self.sid = cookie.strip().split(''='', 1)[1]
+
+                # In case of error 'Invalid CSRF token' retrieve new one and retry the same call
+                # Except for 'deezer.getUserData' method, which would cause infinite loop
+                if ( 'error' in body and 'VALID_TOKEN_REQUIRED' in body['error'] and method != 'deezer.getUserData' and await self.raw_authorize() ):
+                    return await self.call_gw_api(method, params=params, gateway_input=gateway_input)
+                return body
+
+      async def call_public_api(self, path: str) -> Dict[str, Any]:
+            async with aiohttp.ClientSession() as session:
+                async with session.get(f'https://api.deezer.com/{path}'') as resp:
+                    return await resp.json()
+
+        async def get_json_web_token(self) -> str:
+            url = 'https://auth.deezer.com/login/arl'
+            params = {'jo': 'p', 'rto': 'c', 'i': 'c'}
+            headers = self.get_headers()
+            async with aiohttp.ClientSession() as session:
+                async with session.post(url, headers=headers, params=params) as resp:
+                    data = await resp.json()
+                    return data.get('jwt', '')
+
+        async def call_pipe_api(self, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+            jwt_token = await self.get_json_web_token()
+            headers = self.get_headers()
+            headers['Authorization'] = f'Bearer {jwt_token}'
+            headers['Content-Type'] = 'application/json'
+            url = 'https://pipe.deezer.com/api/'
+            async with aiohttp.ClientSession() as session:
+                async with session.post(url, headers=headers, data=json.dumps(params or {})) as resp:
+                    return await resp.json()
+
+    async def authorize(self) -> bool:
+        if self._authorizing is None:
+            self._authorizing = asyncio.ensure_future(self.raw_authorize())
+            result = await self._authorizing
+            self._authorizing = None
+            return result
+        return await self._authorizing
+
+    async def raw_authorize(self) -> bool:
+        try:
+            data = await self.call_gw_api("deezer.getUserData")
+            user = data.get("results", {}).get("USER", {})
+            if user.get("USER_ID") == 0:
+                return False
+
+            self.token = data["results"].get("checkForm")
+            self.user_id = str(user.get("USER_ID", ""))
+            self.user_name = user.get("BLOG_NAME")
+            self.favorites_playlist_id = user.get("LOVEDTRACKS_ID")
+            self.license_token = user.get("OPTIONS", {}).get("license_token")
+            return True
+        except Exception as e:
+            log.exception("Login Error (D): %s", e) # seb TODO: music assistant logging
+            return False
