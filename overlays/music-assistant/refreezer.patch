+    async def get_track_url(self, track_id: str, track_token: str, md5origin: str, media_version: str, quality: str, refresh_attempt: int=0) -> tuple[Optional[str], bool]:
+        '''returns a (url, encrypted) pair for streaming a track. url is a direct media link.'''
+        if self.license_token is None:
+            self.logger.error(f'License token is None, how can that be? I need it here')
+            return None, True
+
+        if quality not in ['FLAC', 'MP3_320', 'MP3_128']:
+            self.loger.error(f'Found unknown quality type "{quality}"')
+            return None, True
+        format = quality
+
+        payload = {
+            "license_token": self.license_token,
+            "media": [ { "type": "FULL", "formats": [{"cipher": "BF_CBC_STRIPE", "format": format}], } ],
+            "track_tokens": [track_token],
+        }
+
+        headers = self.get_headers()
+        headers["Content-Type"] = "application/json"
+
+        try:
+            async with self.session.post('https://media.deezer.com/v1/get_url', headers=headers, data=json.dumps(payload)) as resp:
+                result = await resp.json()
+
+            if 'errors' in result:
+                raise ValueError(f'Encountered the following errors: {result['errors']}')
+
+            if 'data' in result:
+                for data in result['data']:
+                    if 'errors' in data:
+                        for error in data['errors']:
+                            if error.get('code') == 2001 and refresh_attempt < 1:
+                                # track token expired, so refresh track metadata and retry once
+                                track_data = await self.track(track_id)
+                                private_track = track_data['results']['data'][0]
+                                return await self.get_track_url(
+                                    private_track['SNG_ID'],
+                                    private_track['TRACK_TOKEN'],
+                                    private_track['MD5_ORIGIN'],
+                                    private_track['MEDIA_VERSION'],
+                                    quality,
+                                    refresh_attempt + 1,
+                                )
+                        self.logger.warning('Failed in getting streaming URL: %s', data.get('errors'))
+                    if 'media' in data and data['media']:
+                        from pprint import pformat
+                        self.logger.info(f'got data url etc: {data["media"][0]}')
+                        url = data['media'][0]['sources'][0]['url']
+                        return url, True
+        except Exception as e:
+            self.logger.warning("Error getting streaming URL: %s", e)
+        return None, True
